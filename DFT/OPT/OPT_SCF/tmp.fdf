# General system specifications
SystemName          MOS2 molecule
SystemLabel         mos2
NumberOfAtoms       3
NumberOfSpecies     2

# Species index, atomic number, species label
%block ChemicalSpeciesLabel
 1  42 Mo
 2  16 S
%endblock ChemicalSpeciesLabel

# Atomic coordinates
AtomicCoordinatesFormat  Ang
%block AtomicCoordinatesAndAtomicSpecies
  0.00832436    0.00460263    3.29603595   1       
  1.58881538    0.91769003    1.69986798   2    
  1.58882906    0.91770531    4.89107680   2  
%endblock AtomicCoordinatesAndAtomicSpecies

# Unit cell
LatticeConstant 1.0 Ang
%block LatticeVectors
  3.160 0.000  0.000
 -1.580 2.738  0.000
  0.000 0.000 12.295
%endblock LatticeVectors

# Basis set definition
#PAO.EnergyShift 0.05 Ry

%block PAO.Basis                
Mo  7    # Species label, number of l-shells
 n=4   0   1        # n, l, Nzeta
       4.000  
       1.000  
 n=5   0   2        # n, l, Nzeta
       6.800   6.700  
       1.000   1.000  
 n=4   1   1        # n, l, Nzeta
       5.9  
       1.000  
 n=5   1   1        # n, l, Nzeta
       7.900  
       1.000  
 n=4   2   2         # n, l, Nzeta
       7.950   6.250  
       1.000   1.000  
 n=6   0   1  #diffuse s
       10.000
       1.000
 n=6   1   1  #diffuse p
       10.000
       1.000

 
S      4         # Species label, number of l-shells
 n=3   0   2                         # n, l, Nzeta
       7.850    5.250  
       1.000    1.000  
 n=3   1   2 P   1                   # n, l, Nzeta, Polarization, NzetaPol
       6.900    6.300  
       1.000    1.000  
 n=4   0   1  #diffuse s
       10.000
       1.000
 n=4   1   1  #diffuse p
       10.000
       1.000
%endblock PAO.Basis

# K-points
%block kgrid_Monkhorst_Pack
  12 0 0   0.0
  0 12 0   0.0
  0 0 1   0.0
%endblock kgrid_Monkhorst_Pack

# XC functional
XC.Functional GGA
XC.Authors    PBE

# Grid
MeshCutoff 300 Ry

# SCF
MaxSCFIterations 300




DM.Mixer Method Broyden
DM.MixingWeight 0.9
DM.NumberPulay 8
