 -0.5      0.866025  0.0
  0.0      0.0       3.890823
%endblock LatticeVectors
%block PAO.Basis
Mo  7    # Species label, number of l-shells
 n=4   0   1        # n, l, Nzeta
       4.000
       1.000
 n=5   0   2        # n, l, Nzeta
       6.800   6.700
       1.000   1.000
