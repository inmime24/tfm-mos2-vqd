# General system specifications
SystemName          MOS2 molecule
SystemLabel         mos2
NumberOfAtoms       3
NumberOfSpecies     2
# Species index, atomic number, species label
%block ChemicalSpeciesLabel
 1  42 Mo
 2  16 S
%endblock ChemicalSpeciesLabel
# Atomic coordinates
AtomicCoordinatesFormat  Ang
%block AtomicCoordinatesAndAtomicSpecies
  0.00832436    0.00460263    3.29603595   1
  1.58881538    0.91769003    1.69986798   2
  1.58882906    0.91770531    4.89107680   2
%endblock AtomicCoordinatesAndAtomicSpecies
# Unit cell
LatticeConstant 1.0 Ang
%block LatticeVectors
  3.160 0.000  0.000
 -1.580 2.738  0.000
  0.000 0.000 12.295
%endblock LatticeVectors
# Basis set definition
#PAO.EnergyShift 0.05 Ry
%block PAO.Basis
Mo  7    # Species label, number of l-shells
 n=4   0   1        # n, l, Nzeta
       4.000
       1.000
