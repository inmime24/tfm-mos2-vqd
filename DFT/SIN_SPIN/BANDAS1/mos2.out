%endblock PAO.Basis
# K-points
%block kgrid_Monkhorst_Pack
  12 0 0   0.0
  0 12 0   0.0
  0 0 1   0.0
%endblock kgrid_Monkhorst_Pack
# XC functional
XC.Functional GGA
XC.Authors    PBE
# Grid
