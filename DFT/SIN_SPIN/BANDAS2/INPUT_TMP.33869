# General system specifications
SystemName          MOS2 molecule
SystemLabel         mos2
NumberOfAtoms       3
NumberOfSpecies     2
# Species index, atomic number, species label
%block ChemicalSpeciesLabel
 1  42 Mo
 2  16 S
%endblock ChemicalSpeciesLabel
# Atomic coordinates
AtomicCoordinatesFormat Fractional
%block AtomicCoordinatesAndAtomicSpecies
   -0.00000035    0.00000056    0.26800061   1
    0.66666718    0.33333272    0.13886276   2
    0.66666717    0.33333271    0.39713732   2
%endblock AtomicCoordinatesAndAtomicSpecies
# Unit cell
LatticeConstant 3.170 Ang
%block LatticeVectors
  1.0      0.0       0.0
 -0.5      0.866025  0.0
  0.0      0.0       3.890823
%endblock LatticeVectors
%block PAO.Basis
Mo  7    # Species label, number of l-shells
 n=4   0   1        # n, l, Nzeta
       4.000
       1.000
 n=5   0   2        # n, l, Nzeta
       6.800   6.700
       1.000   1.000
 n=4   1   1        # n, l, Nzeta
       5.9
       1.000
 n=5   1   1        # n, l, Nzeta
       7.900
       1.000
 n=4   2   2         # n, l, Nzeta
       7.950   6.250
       1.000   1.000
 n=6   0   1  #diffuse s
       10.000
       1.000
 n=6   1   1  #diffuse p
       10.000
       1.000
S      4         # Species label, number of l-shells
 n=3   0   2                         # n, l, Nzeta
       7.850    5.250
       1.000    1.000
 n=3   1   2 P   1                   # n, l, Nzeta, Polarization, NzetaPol
       6.900    6.300
       1.000    1.000
 n=4   0   1  #diffuse s
       10.000
       1.000
 n=4   1   1  #diffuse p
       10.000
       1.000
%endblock PAO.Basis
# K-points
%block kgrid_Monkhorst_Pack
  12 0 0   0.0
  0 12 0   0.0
  0 0 1   0.0
%endblock kgrid_Monkhorst_Pack
# XC functional
XC.Functional GGA
XC.Authors    PBE
# Grid
MeshCutoff 300 Ry
# SCF
DM.Mixer.Method Pulay
DM.MixingWeight 0.05
DM.NumberPulay 3
MaxSCFIterations 300
WriteKbands .true.
WriteBands .true.
BandLinesScale ReciprocalLatticeVectors
%block Bandlines
  1   0.5000000000   0.000000000   0.0000   M
 30   0.0000000000   0.000000000   0.0000   \Gamma
 45   0.3333333333   0.333333333   0.0000   K
 30   0.5000000000   0.500000000   0.0000   M
%endblock BandLines
